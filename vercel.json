{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "nestjs",
      "entrypoint": "src/main.ts"
    }
  },
  "functions": {
    "backend/src/main.ts": {
      "includeFiles": [
        "backend/node_modules/.prisma/**",
        "backend/node_modules/@prisma/client/**",
        "backend/prisma/schema.prisma"
      ]
    }
  }
}
