{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "builds": [
        {
          "src": "backend/src/main.ts",
          "use": "@vercel/node"
        }
      ],
      "routes": [
        {
          "src": "/_\\/backend/(.*)",
          "dest": "backend/src/main.ts"
        }
      ]
    }
  }
}
